# Copy this file to .env and add your Gemini API key.
GOOGLE_API_KEY=your_gemini_api_key_here

# Models are configurable because Gemini model availability can change.
# The defaults below are examples; replace them with models available to your API key.
GEMINI_WORKOUT_MODEL=gemini-2.5-flash
GEMINI_TIP_MODEL=gemini-2.5-flash

# Optional: PostgreSQL or another SQLAlchemy-supported URL can be used later.
# DATABASE_URL=sqlite:///./fitbuddy.db
